# VeriVoice backend configuration — copy to .env and fill in.
# NEVER commit a real .env with secrets.

# ---- Google Gemini (required for LIVE verification) ----
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model used for every pipeline stage. Must support multimodal audio input.
GEMINI_MODEL=gemini-2.5-flash

# ---- API server ----
# Comma-separated list of allowed browser origins (the Next.js frontend).
ALLOWED_ORIGINS=http://localhost:3000
# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=25
HOST=0.0.0.0
PORT=8000

# ---- Optional persistence ----
# Leave blank to run without a database. When set, each verification is stored.
MONGODB_URI=
MONGODB_DB=verivoice
